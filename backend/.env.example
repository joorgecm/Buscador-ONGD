# ==============================================================================
# Configuración de entorno para el Back-end (Buscador de ONGD - IEI)
# ==============================================================================

# Conexión al almacén PostgreSQL (SQLAlchemy 2.0 + psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/buscador_ongd

# Ruta al archivo CSV de la Comunitat Valenciana (muestra o dataset completo)
CV_CSV_PATH=data/muestra_entidades_CV_20.csv
WRAPPER_CV_URL=http://127.0.0.1:8000/wrappers/cv

# Configuración del Scraper (Selenium + caché en disco)
GEOCACHE_PATH=cache/geocache.json
USAR_SELENIUM=true
SELENIUM_HEADLESS=true

# Clave de API de Groq para la clasificación de ámbito de Catalunya
GROQ_API_KEY=tu_clave_de_groq_aqui

# Orígenes permitidos en CORS (separados en formato JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
